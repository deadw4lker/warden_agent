# --- LLM provider (optional; app works without it in demo rule-based mode) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- WARDEN governance (Mode B). Leave empty for Demo Mode (local simulator). ---
WARDEN_ENDPOINT=
WARDEN_API_KEY=
WARDEN_TIMEOUT_S=5
# Set to 1 to simulate a WARDEN outage (fail-closed test)
WARDEN_SIMULATE_OUTAGE=

# --- Business policy ---
MAX_REFUND_AMOUNT=100000
# Local approval hold is OFF by default (WARDEN decides). Lower to re-enable.
APPROVAL_THRESHOLD=10000000
RETURN_WINDOW_DAYS=30

# --- Chat abuse guard (spam / manipulation auto-block) ---
# Block chat after this many messages inside SPAM_WINDOW_S seconds.
SPAM_MAX_MSGS=15
SPAM_WINDOW_S=60
# Minutes a spam block lasts (manipulation blocks use ABUSE_BLOCK_MIN).
SPAM_BLOCK_MIN=5
ABUSE_BLOCK_MIN=30
# Identical consecutive messages that trigger a flood block.
REPEAT_MAX=4
# Governance BLOCKs in a single turn that trigger a manipulation block.
BULK_BLOCK_THRESHOLD=3

# --- Storage ---
SHOPASSIST_DB=shopassist.db
